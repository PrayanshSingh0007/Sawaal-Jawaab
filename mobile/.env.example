# ── Everything below is OPTIONAL ────────────────────────────────────────────
# The app runs fully without any of these. The core journey
# (Ask → Polish → Show → Understand) never waits on the network.

# Where frontend/ is deployed. The QR code points here, so the person replying
# opens a plain web page instead of being asked to install anything.
EXPO_PUBLIC_COUNTER_URL=

# A server endpoint that holds your Anthropic key. The key is never in the app.
# Without it, the on-device sentence engine answers everything.
EXPO_PUBLIC_AI_ENDPOINT=
EXPO_PUBLIC_AI_MODEL=

# Optional. Lets a reply come back from a different phone.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
