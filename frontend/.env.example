# ── Everything below is OPTIONAL ────────────────────────────────────────────
# Sawaal Jawaab runs completely without any of these. The core journey
# (Ask → Polish → Show → Understand) never waits on the network.

# Server-side only. Read by the dev proxy in vite.config.ts, never bundled.
# Without it, the built-in offline sentence engine is used.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-sonnet-4-6.
VITE_AI_MODEL=

# Optional. Enables cross-device QR handoff + Companion links.
# Without it, handoff works on-device (hand the phone over / same browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
